node_modules/

# Local run output — vydanne writes the export-compliance PDF and the flattened IAP/screenshot PNGs
# next to where it was invoked. Those are per-app artefacts, never the tool's.
*.pdf
*-flat.png

*.log
.DS_Store

# Credentials. vydanne reads the standard .env cascade, so `.env` / `.env.<mode>` stay COMMITTABLE for
# shared non-secret defaults and only the `*.local` files — where secrets actually go — are ignored.
# The account-level default lives outside every repo (see `vydanne auth`).
.env.local
.env.*.local
